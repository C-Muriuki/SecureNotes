<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.DashboardActivity">

    <!-- Top Profile & Header Bar -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_greeting"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxsmall"
                android:text="@string/dashboard_subtitle"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_size_body_secondary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_account"
            android:src="@drawable/ic_user"
            app:tint="@color/colorAccentPrimary" />

    </LinearLayout>

    <!-- Main Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_huge">

            <!-- Search Bar Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchEntry"
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@string/action_search"
                        android:src="@drawable/ic_search"
                        app:tint="@color/colorIconMuted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="@string/action_search"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Daily Writing Quote / Inspiration Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDailyQuote"
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:strokeColor="@color/colorHighlight"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:contentDescription="@string/dashboard_quote_title"
                            android:src="@drawable/ic_sparkles"
                            app:tint="@color/colorHighlight" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:text="@string/dashboard_quote_title"
                            android:textColor="@color/colorHighlight"
                            android:textSize="@dimen/text_size_body_secondary"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/dashboard_prompt_loading"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_body_secondary"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/tvDailyPromptStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:text="@string/dashboard_prompt_loading"
                        android:textColor="@color/colorIconMuted"
                        android:textSize="@dimen/text_size_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Vault Overview Stats Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/dashboard_section_overview"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SecureNotes.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_stat_total_notes"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/tvTotalNotesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:text="@string/dashboard_stat_total_notes_val"
                            android:textColor="@color/colorAccentPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SecureNotes.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_stat_pinned_notes"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/tvPinnedNotesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:text="0"
                            android:textColor="@color/colorHighlight"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Rediscover Vault Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRediscoverVault"
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:contentDescription="@string/rediscover_title"
                            android:src="@drawable/ic_sparkles"
                            app:tint="@color/colorHighlight" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:text="@string/rediscover_dashboard_card_title"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRediscoverCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/colorHighlight"
                            android:paddingStart="@dimen/spacing_small"
                            android:paddingTop="2dp"
                            android:paddingEnd="@dimen/spacing_small"
                            android:paddingBottom="2dp"
                            android:text="0"
                            android:textColor="@color/colorOnPrimary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRediscoverDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:text="@string/rediscover_subtitle"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenRediscover"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/rediscover_title"
                        app:strokeColor="@color/colorHighlight" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Guided Thinking Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGuidedThinking"
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:contentDescription="@string/guided_thinking_title"
                            android:src="@drawable/ic_sparkles"
                            app:tint="@color/colorHighlight" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:text="@string/guided_thinking_title"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:text="@string/guided_thinking_subtitle"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGuidedThinking"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/guided_thinking_title"
                        app:strokeColor="@color/colorHighlight" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pinned Notes Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/dashboard_section_pinned"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPinnedNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_pinned_note" />

            <!-- Thought Connections -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDashboardConnections"
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/thought_connections_subtitle"
                        android:textColor="@color/colorAccentSecondary"
                        android:textSize="@dimen/text_size_subheading"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDashboardConnectionsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:text="@string/thought_connections_empty_dashboard"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body_secondary"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDashboardConnections"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreConnections"
                        style="@style/Widget.SecureNotes.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/thought_connections_explore" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Notes Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/dashboard_section_recent"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_note" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Create Note FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_large"
        android:contentDescription="@string/cd_add_note"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/colorAccentPrimary"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/colorOnPrimary" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorCardSurface"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:itemBackground="@drawable/bottom_nav_item_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
