<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNoteItem"
    style="@style/Widget.SecureNotes.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <ImageButton
            android:id="@+id/ivPinIndicator"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_pin_note"
            android:focusable="true"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_pin"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorHighlight" />

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_note_title"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/text_size_subheading"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ivLockBadge"
            app:layout_constraintStart_toEndOf="@+id/ivPinIndicator"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLockBadge"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:contentDescription="@string/indicator_encrypted"
            android:src="@drawable/ic_lock_shield"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorAccentPrimary" />

        <TextView
            android:id="@+id/tvNotePreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/hint_note_content"
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/text_size_body_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNoteTitle" />

        <TextView
            android:id="@+id/tvNoteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/indicator_edited"
            android:textColor="@color/colorIconMuted"
            android:textSize="@dimen/text_size_caption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNotePreview" />

        <TextView
            android:id="@+id/tvEncryptionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/indicator_encrypted"
            android:textColor="@color/colorAccentPrimary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNotePreview" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
