<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainAccount"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.AccountActivity">

    <!-- Toolbar Header -->
    <LinearLayout
        android:id="@+id/toolbarAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnAccountBack"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/title_account"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/text_size_subheading"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="@dimen/spacing_large"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavAccount"
        app:layout_constraintTop_toBottomOf="@+id/toolbarAccount">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Profile Overview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xlarge">

                    <ImageView
                        android:layout_width="@dimen/profile_avatar_size"
                        android:layout_height="@dimen/profile_avatar_size"
                        android:contentDescription="@string/title_account"
                        android:src="@drawable/ic_user"
                        app:tint="@color/colorAccentPrimary" />

                    <TextView
                        android:id="@+id/tvAccountUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="security_vault_user"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_heading"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccountUserId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:text="@string/account_val_user_id"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_body_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/action_edit_profile"
                        app:strokeColor="@color/colorHighlight" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Account Details & Security Cards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/account_section_user"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_section_security"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="@string/account_val_auth_type"
                        android:textColor="@color/colorAccentPrimary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Device and network information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/account_device_network_header"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_mobile_operator_label"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/tvMobileOperator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="@string/account_operator_unavailable"
                        android:textColor="@color/colorAccentPrimary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/account_operator_permission_note"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Settings & Preferences Shortcut Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsShortcut"
                style="@style/Widget.SecureNotes.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_large">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@string/title_settings"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/colorAccentPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_settings"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_size_subheading"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_theme_summary"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout / Lock Vault Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.SecureNotes.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/action_logout"
                android:textColor="@color/colorOnPrimary"
                app:backgroundTint="@color/colorError" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorCardSurface"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:itemBackground="@drawable/bottom_nav_item_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
