    <!-- Privacy & Security Screen -->
    <string name="privacy_title">Security Architecture</string>
    <string name="privacy_keystore_header">1. Android Keystore System</string>
    <string name="privacy_keystore_desc">Encryption keys are generated and held by Android Keystore, which may use secure hardware when the device supports it. Keys are stored separately for each local account and are never embedded in the app.</string>
    <string name="privacy_cipher_header">2. AES-256-GCM Encryption</string>
    <string name="privacy_cipher_desc">Galois/Counter Mode provides both confidentiality and authenticated integrity verification, detecting any malicious data tampering.</string>
    <string name="privacy_auth_header">3. Salted PBKDF2 Hashing</string>
    <string name="privacy_auth_desc">User authentication uses a unique 128-bit cryptographically random salt and PBKDF2WithHmacSHA256 with 310,000 iterations and a 256-bit derived hash.</string>
    <string name="privacy_db_header">4. SQLite Parameterized Queries</string>
    <string name="privacy_db_desc">Your name, email, salted password hash, and account timestamps are stored locally. Note titles and bodies are encrypted with an account-specific Android Keystore AES-GCM key before SQLite storage. Search decrypts locally while signed in. The dashboard can request a public writing quote from DummyJSON over HTTPS; that request contains no account or note data, and the last quote is cached locally. There is no note sync. Review or delete notes in the app. If local data or its Keystore key is removed or the key becomes unavailable, affected notes cannot be recovered.</string>

