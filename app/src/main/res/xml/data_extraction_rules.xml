<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep encrypted notes local until portable, user-controlled recovery exists. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_notes_session_prefs.xml" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <!-- Device transfer cannot transfer Android Keystore key material safely. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_notes_session_prefs.xml" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
